{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nexus/contracts": ["packages/contracts/src/index.ts"],
      "@nexus/core": ["packages/core/src/index.ts"],
      "@nexus/vanguard": ["packages/vanguard/src/index.ts"],
      "@nexus/identity-ref": ["packages/identity-ref/src/index.ts"],
      "@nexus/cli": ["packages/interfaces/cli/src/index.ts"],
      "@nexus/api": ["packages/interfaces/api/src/server.ts"],
      "@nexus/adapter-mcp": ["packages/adapters/mcp/src/index.ts"],
      "@nexus/connector-stub": ["packages/connectors/stub/stub.connector.ts"],
      "@nexus/runtime-utils": ["packages/runtime-utils/src/index.ts"],
      "@nexus/workspace-ref": ["packages/workspace-ref/src/index.ts"],
      "@nexus/orch-ref": ["packages/orch-ref/src/index.ts"]
    }
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/vanguard/src/**/*.ts",
    "packages/identity-ref/src/**/*.ts",
    "packages/adapters/*/src/**/*.ts",
    "packages/connectors/**/*.ts",
    "packages/runtime-utils/src/**/*.ts",
    "packages/interfaces/*/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.integration.test.ts",
    "**/*.threat.test.ts"
  ]
}
