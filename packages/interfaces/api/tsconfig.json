{
  "extends": "../../../tsconfig.package-build.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.integration.test.ts",
    "**/*.threat.test.ts",
    "**/*.replay.test.ts"
  ],
  "references": [
    {
      "path": "../../contracts"
    }
  ]
}
