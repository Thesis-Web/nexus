{
  "extends": "../../tsconfig.package-build.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/dist/**",
    "**/*.spec.ts",
    "**/*.integration.test.ts",
    "**/*.threat.test.ts",
    "**/*.replay.test.ts"
  ]
}
