# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Runtime databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Ledger run outputs
runs/

# Turbo cache
.turbo/

# Keys — gitignore law per spec §7.1 and blueprint
keys/admin.token
keys/workspace-jwt.secret
keys/workspace-dev-admin.apikey
keys/approvers/
keys/admins/
# Admin-managed API keys (CLAUDE-CODE-SECRET-MANAGEMENT-SPEC)
keys/secrets.json
keys/secrets.json.tmp-*
# Vault encryption key (CLAUDE-CODE-VAULT-SECRET-SOURCE)
keys/vault.key
keys/vault.key.tmp-*

# Environment files
.env
.env.*
!.env.example

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/

# Logs
*.log

# scripts/dev/up.sh runtime state (background nexus serve)
.nexus-serve.pid

# Archived docs (v0 superseded files)
docs/archive-v0/
.pnpm-store/
pnpm-store/

# Stray empty files at repo root caused by shell-redirect typos
# (`> esbuild` etc.). Real tools live in node_modules/.bin and are
# invoked via `pnpm run build`; the names below should never appear
# as plain files at the repo root.
/esbuild
/turbo

# Legacy infra run-ledger at repo root. Runtime state only — the
# authoritative run-ledger lives under runs/infra.run-ledger.jsonl.
/nexus.ledger.jsonl
