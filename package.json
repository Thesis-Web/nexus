{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Action Router and Authority Governance Layer",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "nexus": "packages/interfaces/cli/dist/index.js",
    "nexus-mcp-proxy": "packages/adapters/mcp/dist/mcp-server.js"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint packages --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:threat": "vitest run --config vitest.threat.config.ts",
    "build": "turbo build",
    "ci:gate": "tsx scripts/ci-gate.ts",
    "nexus": "tsx packages/interfaces/cli/src/index.ts",
    "nexus:mcp": "tsx packages/adapters/mcp/src/mcp-server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.30",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.1",
    "better-sqlite3": "^11.9.1",
    "commander": "^13.1.0",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "packageManager": "pnpm@9.15.4"
}
